---
import Icon from "../components/icons/Icon.astro";
import MobileDocTools from "../components/docs/MobileDocTools.astro";
import PageActions from "../components/docs/PageActions.astro";
import SearchBox from "../components/docs/SearchBox.astro";
import SearchTrigger from "../components/docs/SearchTrigger.astro";
import { getDocsNav, getDocsPages, githubBaseUrl } from "../data/docs";
import { localeFromAstro, pathForLocale, uiForLocale } from "../i18n/ui";
import { absoluteUrl, createBreadcrumbSchema, createTechArticleSchema, resolveSiteUrl, type HeadEntry } from "../lib/seo";
import BaseLayout from "./BaseLayout.astro";
import { defaultLocale } from "@netstamp/i18n";

interface Heading {
	depth: 2 | 3;
	slug: string;
	text: string;
}

interface Props {
	title?: string;
	description?: string;
	headings?: Heading[];
	head?: HeadEntry[];
	frontmatter?: {
		title?: string;
		description?: string;
		head?: HeadEntry[];
	};
	fallback?: boolean;
}

const locale = localeFromAstro(Astro.currentLocale);
const ui = uiForLocale(locale);
const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? ui.nav.docs;
const description = Astro.props.description ?? frontmatter.description ?? ui.meta.docsDescription;
const fallback = Astro.props.fallback ?? false;
const head = Astro.props.head ?? frontmatter.head ?? [];
const browserTitle = head.find(entry => entry.tag === "title")?.content ?? `${title} - Netstamp ${ui.nav.docs}`;
const extraHead = head.filter(entry => entry.tag !== "title");
const markdownHeadings = Astro.props.headings?.filter((heading): heading is Heading => heading.depth === 2 || heading.depth === 3) ?? [];
const headings = markdownHeadings;
const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const docsPages = getDocsPages(locale);
const docsNav = getDocsNav(locale);
const currentPageIndex = docsPages.findIndex(page => page.href === pathname);
const currentPage = currentPageIndex >= 0 ? docsPages[currentPageIndex] : undefined;
const previousPage = currentPageIndex > 0 ? docsPages[currentPageIndex - 1] : undefined;
const nextPage = currentPageIndex >= 0 && currentPageIndex < docsPages.length - 1 ? docsPages[currentPageIndex + 1] : undefined;
const englishSourcePath = currentPage ? `docs/src/content/docs/en/${currentPage.contentId}.mdx` : undefined;
const editUrl = locale === defaultLocale && englishSourcePath ? `${githubBaseUrl}/${englishSourcePath}` : locale === defaultLocale ? githubBaseUrl : "https://crowdin.com/project/netstamp";
const siteUrl = resolveSiteUrl(Astro.site);
const pageUrl = absoluteUrl(pathname, siteUrl);
const breadcrumbs = [
	{ name: "Netstamp", url: siteUrl },
	{ name: ui.nav.docs, url: absoluteUrl(pathForLocale("/docs/", locale), siteUrl) },
	{ name: title, url: pageUrl }
];
const schema = [createBreadcrumbSchema(breadcrumbs), createTechArticleSchema(siteUrl, pageUrl, title, description)];
const pageAssistantPrompt = `Please read and explain this documentation page: ${pageUrl}\n\nPlease provide a clear summary and help me understand the key concepts covered in this documentation.`;
const chatGptUrl = `https://chatgpt.com/?q=${encodeURIComponent(pageAssistantPrompt)}`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(pageAssistantPrompt)}`;

const markdownUrl = `${pathname.replace(/\/$/, "")}.md`;
const isActiveNavItem = (href: string) => pathname === href;

const navGroups = docsNav.map(group => ({
	...group,
	id: group.key,
	active: group.items.some(item => isActiveNavItem(item.href)),
	items: group.items.map(item => ({
		...item,
		active: isActiveNavItem(item.href)
	}))
}));
const externalLinks = [
	{ title: "OpenAPI", href: pathForLocale("/openapi/", locale) },
	{ title: "Storybook", href: "/storybook/", reload: true }
];
const currentGroup = navGroups.find(group => group.active);
const visibleBreadcrumbs = [
	{ name: ui.docs.home, href: pathForLocale("/docs/", locale), current: false, icon: "home" as const },
	currentGroup ? { name: currentGroup.title, href: currentGroup.items[0]?.href ?? pathForLocale("/docs/", locale), current: false } : undefined,
	{ name: title, href: pathname, current: true }
].filter((item): item is { name: string; href: string; current: boolean; icon?: "home" } => Boolean(item));
---

<BaseLayout title={browserTitle} description={description} head={extraHead} canonicalPath={pathname} ogType="article" schema={schema}>
	<SearchBox />
	<div class="docsShell" data-docs-shell>
		<aside class="docsSidebar" aria-label={ui.docs.navigation} data-docs-sidebar data-docs-locale={locale} transition:persist="docs-sidebar">
			<SearchTrigger />
			<nav class="docsNavTree" id="docs-nav-tree">
				{
					navGroups.map(group => (
						<section class:list={["docsNavSection", group.active && "active"]} aria-labelledby={`docs-nav-section-${group.id}`} data-docs-nav-section>
							<h2 class="docsNavSectionTitle" id={`docs-nav-section-${group.id}`}>
								{group.title}
							</h2>
							{group.items.map(item => (
								<a href={item.href} class:list={["docsNavItem", item.active && "active"]} aria-current={item.active ? "page" : undefined} title={item.title} data-docs-nav-item>
									<span>{item.title}</span>
								</a>
							))}
						</section>
					))
				}
				<section class="docsNavSection docsExternalLinks" aria-labelledby="docs-nav-section-external">
					<h2 class="docsNavSectionTitle" id="docs-nav-section-external">{ui.docs.externalLinks}</h2>
					{
						externalLinks.map(link => (
							<a href={link.href} class="docsExternalLink" data-astro-reload={link.reload ? true : undefined}>
								<span>{link.title}</span>
								<Icon name="arrowUpRight" size={13} />
							</a>
						))
					}
				</section>
			</nav>
		</aside>

		<main id="content" class="docContent">
			<nav class="docBreadcrumb" aria-label={ui.docs.breadcrumb}>
				<ol>
					{
						visibleBreadcrumbs.map((item, index) => (
							<li>
								{item.current ? (
									<span aria-current="page" title={item.name}>
										{item.icon ? <Icon name={item.icon} size={14} /> : item.name}
									</span>
								) : (
									<a href={item.href} title={item.name} aria-label={item.icon ? item.name : undefined}>
										{item.icon ? <Icon name={item.icon} size={14} /> : item.name}
									</a>
								)}
								{index < visibleBreadcrumbs.length - 1 && (
									<span class="docBreadcrumbSeparator" aria-hidden="true">
										<Icon name="caretRight" size={12} />
									</span>
								)}
							</li>
						))
					}
				</ol>
			</nav>
			<h1 class="docTitle">{title}</h1>
			<p class="docDescription">{description}</p>
			{
				fallback ? (
					<aside class="translationFallback" role="note">
						<span>{ui.docs.fallbackNotice}</span>
						<a href={pathForLocale(Astro.url.pathname, "en")}>{ui.docs.fallbackLink}</a>
					</aside>
				) : null
			}
			<MobileDocTools chatGptUrl={chatGptUrl} claudeUrl={claudeUrl} headings={headings} markdownUrl={markdownUrl} onThisPageLabel={ui.docs.onThisPage} />
			<article class="docProse">
				<slot />
			</article>
			<footer class="docFooter">
				<a class="editLink" href={editUrl} target="_blank" rel="noreferrer">
					<Icon name="edit" size={16} />
					{ui.docs.edit}
				</a>
				<nav class="docPager" aria-label={ui.docs.pagination}>
					{
						previousPage ? (
							<a class="docPagerLink previous" href={previousPage.href}>
								<Icon name="arrowLeft" size={18} />
								<span>
									<small>{ui.docs.previous}</small>
									<strong>{previousPage.title}</strong>
								</span>
							</a>
						) : (
							<span class="docPagerLink previous disabled" aria-disabled="true">
								<Icon name="arrowLeft" size={18} />
								<span>
									<small>{ui.docs.previous}</small>
									<strong>{ui.docs.noPrevious}</strong>
								</span>
							</span>
						)
					}
					{
						nextPage ? (
							<a class="docPagerLink next" href={nextPage.href}>
								<span>
									<small>{ui.docs.next}</small>
									<strong>{nextPage.title}</strong>
								</span>
								<Icon name="arrowRight" size={18} />
							</a>
						) : (
							<span class="docPagerLink next disabled" aria-disabled="true">
								<span>
									<small>{ui.docs.next}</small>
									<strong>{ui.docs.noNext}</strong>
								</span>
								<Icon name="arrowRight" size={18} />
							</span>
						)
					}
				</nav>
			</footer>
		</main>

		<aside class="docsToc" aria-label={ui.docs.onThisPage}>
			<div class="docsTocInner">
				<PageActions idPrefix="docs-desktop-page-actions" chatGptUrl={chatGptUrl} claudeUrl={claudeUrl} markdownUrl={markdownUrl} />
				{
					headings.length ? (
						<nav data-docs-toc>
							{headings.map((heading, index) => (
								<a href={`#${heading.slug}`} data-toc-link class:list={[heading.depth === 3 && "sub", index === 0 && "active"]} aria-current={index === 0 ? "location" : undefined}>
									{heading.text}
								</a>
							))}
						</nav>
					) : (
						<p>{ui.docs.noHeadings}</p>
					)
				}
			</div>
		</aside>
	</div>

	<script>
		import "../scripts/docLayout";
	</script>

	<style>
		.docsShell {
			--docs-sticky-top: 6.25rem;
			display: grid;
			grid-template-columns: minmax(13rem, 15.5rem) minmax(0, 46rem) minmax(11rem, 14rem);
			justify-content: center;
			align-items: start;
			column-gap: clamp(1.5rem, 3vw, 3rem);
			min-height: 100svh;
			padding: 7.25rem clamp(1.25rem, 4vw, 3rem) 3rem;
			color: var(--ns-text);
			background: var(--ns-bg);
		}

		.docsNavItem:focus-visible,
		.docsExternalLink:focus-visible,
		.docBreadcrumb a:focus-visible,
		.docPagerLink:focus-visible,
		.docsToc a:focus-visible,
		:global(.editLink:focus-visible) {
			outline: var(--ns-focus-outline);
			outline-offset: 0.25rem;
		}

		.docsSidebar {
			position: sticky;
			top: var(--docs-sticky-top);
			align-self: start;
			max-height: calc(100svh - var(--docs-sticky-top) - 1.5rem);
			overflow: auto;
			scrollbar-gutter: stable;
		}

		.docsSidebar {
			display: grid;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.docsToc {
			min-width: 0;
		}

		.docsTocInner {
			position: fixed;
			top: var(--docs-sticky-top);
			width: min(14rem, 16vw);
			max-width: calc(100vw - 2rem);
			overflow: visible;
		}

		:global(.icon) {
			flex: 0 0 auto;
		}

		.docsNavSectionTitle {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			margin: 0 0 0.325rem;
			color: var(--ns-text-low);
			font-size: 0.68rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.docsNavTree {
			display: grid;
			gap: 1.25rem;
		}

		.docsNavSection {
			display: grid;
			gap: 0.125rem;
		}

		.docsNavItem {
			position: relative;
			display: block;
			padding: 0.42rem 0.55rem;
			color: var(--ns-text-subtle);
			border-left: 2px solid transparent;
			font-size: 0.9rem;
			line-height: 1.35;
			text-decoration: none;
			transition:
				border-color var(--ns-transition),
				background var(--ns-transition),
				color var(--ns-transition);
		}

		.docsNavItem:hover,
		.docsNavItem.active {
			color: var(--ns-primary-hover);
			background: var(--ns-primary-muted);
		}

		.docsNavItem.active {
			border-left-color: var(--ns-primary);
			color: var(--ns-text);
			font-weight: 700;
		}

		.docsNavItem span {
			display: block;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.docsExternalLinks {
			padding-top: 0.25rem;
			border-top: 1px solid var(--ns-border-faint);
		}

		.docsExternalLink {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.42rem 0.5rem 0.42rem 0.55rem;
			color: var(--ns-text-subtle);
			border-left: 2px solid transparent;
			font-size: 0.9rem;
			line-height: 1.35;
			text-decoration: none;
			transition:
				background var(--ns-transition),
				color var(--ns-transition);
		}

		.docsExternalLink:hover,
		.docsExternalLink:focus-visible {
			color: var(--ns-primary-hover);
			background: var(--ns-primary-muted);
		}

		.docsExternalLink span {
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.docContent {
			min-width: 0;
			align-self: start;
		}

		.docBreadcrumb {
			margin: 0.25rem 0 0;
		}

		.docBreadcrumb ol {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.35rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.docBreadcrumb li {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
			min-width: 0;
		}

		.docBreadcrumb a,
		.docBreadcrumb span {
			display: inline-flex;
			align-items: center;
			min-width: 0;
			overflow: hidden;
			color: var(--ns-text-low);
			font-family: var(--ns-font-code);
			font-size: 0.72rem;
			font-weight: 500;
			letter-spacing: 0.09em;
			text-decoration: none;
			text-overflow: ellipsis;
			text-transform: uppercase;
			white-space: nowrap;
		}

		.docBreadcrumb a:hover,
		.docBreadcrumb span {
			color: var(--ns-primary-hover);
		}

		.docBreadcrumb .docBreadcrumbSeparator {
			color: var(--ns-text-low);
			opacity: 0.8;
		}

		.docTitle {
			max-width: 20ch;
			margin: 1.5rem 0 1rem;
			font-size: clamp(2.1rem, 4vw, 3.25rem);
			font-weight: 850;
			letter-spacing: 0;
			line-height: 1.02;
		}

		.docDescription {
			max-width: 58ch;
			margin: 0 0 2.25rem;
			color: var(--ns-text-muted);
			font-size: 1.06rem;
			line-height: 1.72;
		}

		:global(.editLink) {
			--ns-frame-color: transparent;
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			width: fit-content;
			margin-bottom: 1rem;
			padding: 0;
			color: var(--ns-primary);
			background: transparent;
			font-family: var(--ns-font-code);
			font-size: 0.75rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			text-decoration: none;
			text-transform: uppercase;
		}

		:global(.editLink:hover) {
			--ns-frame-color: transparent;
			color: var(--ns-primary-hover);
			background: transparent;
			text-decoration: underline;
			text-underline-offset: 0.18em;
		}

		.docProse {
			display: grid;
			gap: 1.35rem;
			margin: 0 0 1.75rem;
			padding: 0 0 0.5rem;
		}

		.docFooter {
			display: grid;
			gap: 1rem;
			padding: 0 0 5rem;
		}

		.docPager {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
		}

		.docPagerLink {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			min-height: 4.5rem;
			padding: 0.9rem;
			color: var(--ns-text-subtle);
			border: 1px solid color-mix(in srgb, var(--ns-border-faint) 72%, transparent);
			text-decoration: none;
			transition:
				border-color var(--ns-transition),
				color var(--ns-transition),
				transform var(--ns-transition);
		}

		.docPagerLink.next {
			justify-content: flex-end;
			text-align: right;
		}

		.docPagerLink:hover {
			border-color: var(--ns-primary-border);
			color: var(--ns-primary-hover);
			transform: translateY(-0.0625rem);
		}

		.docPagerLink.disabled {
			color: var(--ns-text-low);
			transform: none;
		}

		.docPagerLink span {
			display: grid;
			gap: 0.25rem;
			min-width: 0;
		}

		.docPagerLink small {
			color: var(--ns-text-low);
			font-family: var(--ns-font-code);
			font-size: 0.68rem;
			font-weight: 800;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.docPagerLink strong {
			overflow: hidden;
			color: inherit;
			font-family: var(--ns-font-code);
			font-size: 0.86rem;
			letter-spacing: 0.04em;
			text-overflow: ellipsis;
			text-transform: uppercase;
			white-space: nowrap;
		}

		:global(.docProse h2),
		:global(.docProse h3) {
			scroll-margin-top: 6rem;
			margin: 0;
			color: var(--ns-text);
			letter-spacing: 0;
		}

		:global(.docProse h2) {
			font-size: clamp(1.55rem, 3vw, 2.25rem);
			line-height: 1.08;
		}

		:global(.docProse h3) {
			font-size: clamp(1.15rem, 2vw, 1.45rem);
		}

		:global(.docProse p),
		:global(.docProse li) {
			color: var(--ns-text-muted);
			font-size: 1rem;
			line-height: 1.75;
		}

		:global(.docProse p),
		:global(.docProse ul),
		:global(.docProse ol) {
			margin: 0;
		}

		:global(.docProse ul),
		:global(.docProse ol) {
			display: grid;
			gap: 0.45rem;
			padding-left: 1.2rem;
		}

		:global(.docProse a) {
			color: var(--ns-primary-hover);
		}

		:global(.docProse code:not(pre code)) {
			padding: 0.1rem 0.28rem;
			color: var(--ns-primary-hover);
			background: var(--ns-primary-muted);
			font-family: var(--ns-font-code);
			font-size: 0.9em;
		}

		:global(.docProse .docTableScroller) {
			width: 100%;
			max-width: 100%;
			overflow-x: auto;
		}

		:global(.docProse .docTableScroller:focus-visible) {
			outline: var(--ns-focus-outline);
			outline-offset: 0.25rem;
		}

		:global(.docProse table) {
			display: table;
			width: 100%;
			min-width: 100%;
			border: 1px solid var(--ns-border);
			border-collapse: collapse;
			background: var(--ns-surface);
		}

		:global(.docProse thead) {
			background: var(--ns-container-bg);
		}

		:global(.docProse th),
		:global(.docProse td) {
			min-width: 12rem;
			padding: 0.75rem 1rem;
			border-bottom: 1px solid var(--ns-border-faint);
			color: var(--ns-text-muted);
			font-size: 0.9rem;
			line-height: 1.5;
			text-align: left;
			vertical-align: top;
		}

		:global(.docProse th) {
			color: var(--ns-text);
			font-family: var(--ns-font-code);
			font-size: 0.75rem;
			font-weight: 800;
			letter-spacing: 0.06em;
			white-space: nowrap;
		}

		:global(.docProse tbody tr:last-child td) {
			border-bottom: 0;
		}

		:global(.docProse tbody tr) {
			transition: background var(--ns-transition);
		}

		:global(.docProse tbody tr:hover) {
			background: var(--ns-container-bg-hover);
		}

		:global(.docProse .docCodeBlock) {
			--ns-frame-color: var(--ns-border);
			display: grid;
			grid-template-rows: auto minmax(0, auto);
			min-width: 0;
			overflow: hidden;
			background: var(--ns-surface-deep);
			box-shadow: none;
		}

		:global(.docProse .docCodeHeader) {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			min-width: 0;
			min-height: 2rem;
			padding: 0.25rem 0.5rem;
			border-bottom: 1px solid var(--ns-border-faint);
			background: var(--ns-surface-raised);
			color: var(--ns-text-low);
			font-family: var(--ns-font-code);
			font-size: 0.6875rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		:global(.docProse .docCodeWindowControls) {
			display: inline-flex;
			flex: 0 0 auto;
			align-items: center;
			gap: 0.25rem;
		}

		:global(.docProse .docCodeWindowControl) {
			width: 0.5rem;
			height: 0.5rem;
			background: var(--ns-critical);
		}

		:global(.docProse .docCodeWindowControl:nth-child(2)) {
			background: var(--ns-warning);
		}

		:global(.docProse .docCodeWindowControl:nth-child(3)) {
			background: var(--ns-success);
		}

		:global(.docProse .docCodeLanguage) {
			min-width: 0;
			overflow: hidden;
			color: var(--ns-text-muted);
			font-weight: 800;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		:global(.docProse .docCodeCopyButton) {
			min-height: 1.5rem;
			margin-left: auto;
			padding: 0 0.5rem;
			border: 1px solid var(--ns-border-faint);
			background: transparent;
			color: var(--ns-text-muted);
			font: inherit;
			letter-spacing: 0;
			text-transform: none;
			cursor: pointer;
			transition:
				background-color var(--ns-transition),
				border-color var(--ns-transition),
				color var(--ns-transition);
		}

