---
import { render } from "astro:content";
import { defaultLocale } from "@netstamp/i18n";
import { getDocEntry } from "../../data/docs";
import { localeFromAstro } from "../../i18n/ui";
import DocLayout from "../../layouts/DocLayout.astro";

interface Props {
	contentId: string;
}

const { contentId } = Astro.props;
const { entry, translated } = getDocEntry(contentId, Astro.currentLocale);

if (!entry) {
	throw new Error(`Missing English documentation source for ${contentId}.`);
}

const { Content, headings } = await render(entry);
const fallback = localeFromAstro(Astro.currentLocale) !== defaultLocale && !translated;
---

<DocLayout title={entry.data.title} description={entry.data.description} headings={headings} head={entry.data.head} fallback={fallback}>
	<Content />
</DocLayout>
