# Netstamp self-host settings.
#
# Copy this file to .env, fill every value in the required group, then run:
# docker compose up -d

# Required before the first start
# Generate a different value for each line with: openssl rand -hex 32
DATABASE_PASSWORD=
LOG_PSEUDONYM_KEY=
SYSTEM_SETTINGS_ENCRYPTION_KEY=
AUTH_SESSION_HASH_KEY=
AUTH_API_TOKEN_HASH_KEY=

# Required only when exposing Netstamp publicly
# Uncomment both lines, use the external HTTPS origin, and configure your reverse proxy.
# APP_ENV=production
# PUBLIC_BASE_URL=https://netstamp.example.com

# Optional settings are documented at:
# https://netstamp.dev/docs/reference/configuration/
