{
	"name": "@netstamp/web",
	"private": true,
	"type": "module",
	"scripts": {
		"prebuild": "pnpm --filter @netstamp/i18n build && pnpm --filter @netstamp/ui build",
		"build": "vite build",
		"predev": "pnpm --filter @netstamp/i18n build && pnpm --filter @netstamp/ui build",
		"dev": "vite",
		"generate:api-types": "openapi-typescript ../docs/public/openapi.json -o src/shared/api/openapi.d.ts && node scripts/generate-api-metadata.mjs",
		"lint": "eslint .",
		"preview": "vite preview",
		"pretest": "pnpm --filter @netstamp/i18n build && pnpm --filter @netstamp/ui build",
		"test": "vitest run",
		"pretypecheck": "pnpm --filter @netstamp/i18n build && pnpm --filter @netstamp/ui build",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@netstamp/brand": "workspace:*",
		"@netstamp/i18n": "workspace:*",
		"@netstamp/ui": "workspace:*",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.101.4",
		"echarts": "^6.1.0",
		"i18next": "^26.3.6",
		"maplibre-gl": "^6.4.1",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-helmet-async": "^3.0.0",
		"react-i18next": "^17.0.11",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"jsdom": "^30.0.1",
		"openapi-typescript": "^7.13.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	}
}
